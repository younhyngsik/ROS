<?xml version="1.0"?>
<robot name="multi_arm_robot">

  <!-- 재질 정의 -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <!-- 몸체 (Base) -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.6" radius="0.2"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.6" radius="0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
    </inertial>
  </link>

  <!-- [기존 부분] 다리 및 바퀴 (오른쪽/왼쪽 생략 없이 유지) -->
  <!-- ... 다리 코드 생략 (기존과 동일하므로 공간상 핵심 위주로 작성) ... -->
  <!-- (실제 파일에는 기존의 right_leg, right_base, wheels 등이 그대로 들어있어야 합니다) -->

  <!-- ================= [복구된 중앙 그립퍼] ================= -->
  <joint name="gripper_extension" type="prismatic">
    <parent link="base_link"/>
    <child link="gripper_pole"/>
    <limit effort="1000" lower="-0.38" upper="0" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0.19 0 0.2"/>
  </joint>

  <link name="gripper_pole">
    <visual>
      <geometry><cylinder length="0.2" radius="0.01"/></geometry>
      <origin rpy="0 1.57075 0 " xyz="0.1 0 0"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
    </inertial>
  </link>

  <!-- 중앙 왼쪽 집게 -->
  <joint name="left_gripper_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 0" xyz="0.2 0.01 0"/>
    <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
    <parent link="gripper_pole"/>
    <child link="left_gripper"/>
  </joint>
  <link name="left_gripper">
    <visual>
      <origin rpy="0.0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://tf2_basic/meshes/l_finger.dae"/></geometry>
    </visual>
  </link>

  <!-- 중앙 오른쪽 집게 -->
  <joint name="right_gripper_joint" type="revolute">
    <axis xyz="0 0 -1"/>
    <origin rpy="0 0 0" xyz="0.2 -0.01 0"/>
    <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
    <parent link="gripper_pole"/>
    <child link="right_gripper"/>
  </joint>
  <link name="right_gripper">
    <visual>
      <origin rpy="-3.1415 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://tf2_basic/meshes/l_finger.dae"/></geometry>
    </visual>
  </link>

  <!-- ================= [새로 추가된 양쪽 2마디 팔] ================= -->

  <!-- 1. 왼팔 (Left New Arm) -->
  <!-- 어깨 관절 -->
  <joint name="left_arm_shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="left_arm_upper"/>
    <origin xyz="0 0.2 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.57" upper="1.57" velocity="0.5"/>
  </joint>

  <link name="left_arm_upper">
    <visual>
      <geometry><cylinder length="0.2" radius="0.02"/></geometry>
      <origin rpy="0 1.57075 0" xyz="0.1 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- 팔꿈치 관절 -->
  <joint name="left_arm_elbow_joint" type="revolute">
    <parent link="left_arm_upper"/>
    <child link="left_arm_forearm"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.57" upper="1.57" velocity="0.5"/>
  </joint>

  <link name="left_arm_forearm">
    <visual>
      <geometry><cylinder length="0.15" radius="0.015"/></geometry>
      <origin rpy="0 1.57075 0" xyz="0.075 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- 2. 오른팔 (Right New Arm) -->
  <!-- 어깨 관절 -->
  <joint name="right_arm_shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="right_arm_upper"/>
    <origin xyz="0 -0.2 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.57" upper="1.57" velocity="0.5"/>
  </joint>

  <link name="right_arm_upper">
    <visual>
      <geometry><cylinder length="0.2" radius="0.02"/></geometry>
      <origin rpy="0 1.57075 0" xyz="0.1 0 0"/>
      <material name="white"/>
    </visual>
  </link>

  <!-- 팔꿈치 관절 -->
  <joint name="right_arm_elbow_joint" type="revolute">
    <parent link="right_arm_upper"/>
    <child link="right_arm_forearm"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" lower="-1.57" upper="1.57" velocity="0.5"/>
  </joint>

  <link name="right_arm_forearm">
    <visual>
      <geometry><cylinder length="0.15" radius="0.015"/></geometry>
      <origin rpy="0 1.57075 0" xyz="0.075 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- [기존 부분] 머리 및 박스 -->
  <link name="head">
    <visual>
      <geometry><sphere radius="0.2"/></geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="head_swivel" type="continuous">
    <parent link="base_link"/><child link="head"/><axis xyz="0 0 1"/><origin xyz="0 0 0.3"/>
  </joint>

</robot>